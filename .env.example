# Application Configuration
# Set to 'production' for production deployment
NODE_ENV=production
PORT=8001
HOST=0.0.0.0
# LOG_LEVEL options: fatal, error, warn, info, debug, trace
# Use 'info' or 'warn' for production
LOG_LEVEL=info

# Database Configuration
# DEPLOYMENT GUIDE:
# - Linux (Docker with host network):     DB_HOST=localhost
# - macOS/Windows (Docker with bridge):   DB_HOST=host.docker.internal
# - Local development (non-Docker):       DB_HOST=localhost
#
# Current configuration is for Linux deployment
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Pay Configuration
API_PAY=https://api.usdt247.shop/partners/orders
PARTNER_APP_KEY=your_partner_app_key_here

# Webhook Configuration
WEBHOOK_PUBLIC_KEY="your_webhook_public_key_here"

# Swagger/OpenAPI Configuration
# Production URL for Swagger UI (without trailing slash or protocol prefix)
# Examples:
#   Production: URL_SWAGGER=https://api.yourdomain.com
#   Staging:    URL_SWAGGER=https://api-staging.yourdomain.com
# Leave empty or unset for development (will use localhost:PORT)
URL_SWAGGER=


