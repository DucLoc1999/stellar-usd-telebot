# Application Configuration
# Set to 'production' for production deployment
NODE_ENV=production
PORT=8001
HOST=0.0.0.0
# Time zone (e.g., Asia/Ho_Chi_Minh, UTC, America/New_York)
TIME_ZONE=Asia/Ho_Chi_Minh
# LOG_LEVEL options: fatal, error, warn, info, debug, trace
# Use 'info' or 'warn' for production
LOG_LEVEL=info

# Database Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# PayConfiguration
API_PAY=
PARTNER_APP_KEY=

# Webhook Configuration
WEBHOOK_PUBLIC_KEY=

URL_SWAGGER=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MESSAGE_DELAY_MS=200

# Payment Configuration
CHAIN_ID=
TOKEN_ADDRESS=
TOKEN_CODE=
CALLBACK_URL=

# Stellar
STELLAR_NETWORK=public  # public | testnet

# FPT service
FPT_API_SERVICE_URL=
FPT_API_SERVICE_KEY=

# S3 service
SECRET_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
BUCKET=

# Sentry Configuration
# Get your DSN from https://sentry.io/settings/projects/
SENTRY_DSN=https://cc15725447a2886dc226b967306e2155@o4510340414477952.ingest.us.sentry.io/4510340414832640
# Sample rate for performance monitoring (0.0 to 1.0)
# 1.0 = 100% of transactions are sent to Sentry
# Reduce this in high-traffic production environments (e.g., 0.1 for 10%)
SENTRY_TRACES_SAMPLE_RATE=1.0
